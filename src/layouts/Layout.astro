---
import type { ImageMetadata } from 'astro';
import Analytics from '../components/Analytics.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import LocaleRedirect from '../components/LocaleRedirect.astro';
import { site, social } from '../data/site';
import {
  defaultLocale,
  getContent,
  localizePath,
  locales,
  ogLocales,
  withBase,
  type Locale,
} from '../i18n';

// Global CSS, in cascade order. Astro bundles, minifies and fingerprints these,
// which a `<link>` to a file in `public/` would not get. Component-specific
// rules live in a scoped `<style>` in the component that owns the markup, and
// `blog.css` is imported by the two listing pages that share it.
import '../styles/vendor/flexboxgrid.css';
import '../styles/vendor/normalize.css';
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/base.css';
import '../styles/ui.css';
import '../styles/sections.css';

// The Gilroy files every page renders with on first paint, preloaded so they
// arrive before the fallback has been laid out. Same fingerprinted files as
// the `@font-face` rules in `fonts.css`.
import gilroy400 from '../assets/fonts/Gilroy/393C60_1_0.woff2?url';
import gilroy500 from '../assets/fonts/Gilroy/393C60_2_0.woff2?url';
import gilroy600 from '../assets/fonts/Gilroy/393C60_0_0.woff2?url';
import gilroy700 from '../assets/fonts/Gilroy/393C60_3_0.woff2?url';

const preloadFonts = [gilroy400, gilroy500, gilroy600, gilroy700];

interface Props {
  locale: Locale;
  /** Current path with the locale prefix stripped, e.g. `/contacts/`. */
  path?: string;
  /** Per-locale override of `path`, for pages that are not translated everywhere. */
  paths?: Record<Locale, string>;
  /** Locales with an equivalent of this page, for the `hreflang` alternates; all by default. */
  translated?: readonly Locale[];
  title?: string;
  description?: string;
  /** Social preview image, root-relative or imported; the site default when omitted. */
  image?: string | ImageMetadata;
  /** Set for a blog post: switches `og:type` to `article`. */
  publishedTime?: Date;
  /** Page-specific structured data, rendered as JSON-LD next to the site-wide schemas. */
  schema?: Record<string, unknown>;
  bodyClass?: string;
}

const {
  locale,
  path = '/',
  translated = locales,
  image = site.ogImage,
  publishedTime,
  schema,
  bodyClass = '',
} = Astro.props;
const { meta } = getContent(locale);
const title = Astro.props.title ?? meta.title;
const description = Astro.props.description ?? meta.description;

// Absolute URLs derive from the `site` + `base` pair in astro.config.mjs, so
// they stay correct on GitHub Pages and after a move to a custom domain.
const origin = Astro.site!;
const siteRoot = new URL(withBase('/'), origin).href;
const canonical = new URL(localizePath(path, locale), origin).href;
const alternates =
  Astro.props.paths ??
  (Object.fromEntries(locales.map((code) => [code, path])) as Record<Locale, string>);
const alternateHref = (code: Locale) => new URL(localizePath(alternates[code], code), origin).href;
const imageUrl = new URL(typeof image === 'string' ? withBase(image) : image.src, origin).href;

// The browser's language decides where a visitor starts, but only on the
// unprefixed landing page and only once per session, so it never overrides a
// link into a specific locale or a switch made with the flags.
const detectLocale = locale === defaultLocale && path === '/';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteRoot}#website`,
  url: siteRoot,
  name: site.name,
  inLanguage: locale,
  publisher: { '@id': `${siteRoot}#organization` },
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteRoot}#organization`,
  url: siteRoot,
  sameAs: social.map((link) => link.href),
  name: site.organization,
  logo: new URL(withBase(site.logo), origin).href,
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    {detectLocale && <LocaleRedirect />}
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {preloadFonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="max-image-preview:large" />
    <link rel="canonical" href={canonical} />

    <link rel="shortcut icon" href={withBase('/favicons/favicon.ico')} type="image/x-icon" />
    <link rel="icon" sizes="16x16" href={withBase('/favicons/favicon-16x16.png')} type="image/png" />
    <link rel="icon" sizes="32x32" href={withBase('/favicons/favicon-32x32.png')} type="image/png" />
    <link rel="icon" sizes="512x512" href={withBase('/favicons/favicon-512x512.png')} type="image/png" />
    <link rel="apple-touch-icon" href={withBase('/favicons/apple-touch-icon.png')} />

    {
      translated.length > 1 &&
        translated.map((code) => (
          <link rel="alternate" hreflang={code} href={alternateHref(code)} />
        ))
    }
    {
      translated.length > 1 && translated.includes(defaultLocale) && (
        <link rel="alternate" hreflang="x-default" href={alternateHref(defaultLocale)} />
      )
    }

    <meta property="og:locale" content={ogLocales[locale]} />
    {
      translated
        .filter((code) => code !== locale)
        .map((code) => <meta property="og:locale:alternate" content={ogLocales[code]} />)
    }
    <meta property="og:type" content={publishedTime ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={imageUrl} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} is:inline />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />}
  </head>
  <body class:list={['page-wrapper', 'push-container', bodyClass]}>
    {/* In <body>, not <head>: the consent bar is an <aside>, which would end
        <head> early and push the title and meta tags after it into <body>. */}
    <Analytics locale={locale} />
    <Header locale={locale} path={path} paths={alternates} />
    <div class="content-wrapper push-container">
      <main>
        <slot />
      </main>
      <Footer locale={locale} path={path} paths={alternates} />
    </div>
  </body>
</html>
