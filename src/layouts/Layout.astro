---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Modals from '../components/Modals.astro';
import { site } from '../data/site';
import { getContent, localizePath, locales, ogLocales, withBase, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** Current path with the locale prefix stripped, e.g. `/contacts/`. */
  path?: string;
  /** Per-locale override of `path`, for pages that are not translated everywhere. */
  paths?: Record<Locale, string>;
  title?: string;
  description?: string;
  bodyClass?: string;
  /** Snap each top-level `<section>` to the top of the viewport while scrolling. */
  snapScroll?: boolean;
}

const { locale, path = '/', bodyClass = '', snapScroll = false } = Astro.props;
const { meta } = getContent(locale);
const title = Astro.props.title ?? meta.title;
const description = Astro.props.description ?? meta.description;

// Absolute URLs derive from the `site` + `base` pair in astro.config.mjs, so
// they stay correct on GitHub Pages and after a move to a custom domain.
const origin = Astro.site!;
const siteRoot = new URL(withBase('/'), origin).href;
const canonical = new URL(localizePath(path, locale), origin).href;
const alternates =
  Astro.props.paths ??
  (Object.fromEntries(locales.map((code) => [code, path])) as Record<Locale, string>);

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteRoot}#website`,
  url: siteRoot,
  name: site.name,
  inLanguage: locale,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteRoot}?s={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteRoot}#organization`,
  url: siteRoot,
  sameAs: [],
  name: site.organization,
  logo: new URL(withBase(site.logo), origin).href,
};
---

<!doctype html>
<html lang={locale} class:list={{ 'snap-sections': snapScroll }}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta
      name="viewport"
      content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="max-image-preview:large" />
    <link rel="canonical" href={canonical} />

    <link rel="shortcut icon" href={withBase('/favicons/favicon.ico')} type="image/x-icon" />
    <link rel="icon" sizes="16x16" href={withBase('/favicons/favicon-16x16.png')} type="image/png" />
    <link rel="icon" sizes="32x32" href={withBase('/favicons/favicon-32x32.png')} type="image/png" />
    <link rel="icon" sizes="512x512" href={withBase('/favicons/favicon-512x512.png')} type="image/png" />
    <link rel="apple-touch-icon" href={withBase('/favicons/apple-touch-icon.png')} />

    {
      locales.map((code) => (
        <link
          rel="alternate"
          hreflang={code}
          href={new URL(localizePath(alternates[code], code), origin).href}
        />
      ))
    }

    <meta property="og:locale" content={ogLocales[locale]} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="stylesheet" href={withBase('/theme/style.css')} />

    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} is:inline />

    <style is:global>
      html.snap-sections {
        scroll-snap-type: y proximity;
        scroll-padding-top: 3.75rem;
      }

      @media (min-width: 1440px) {
        html.snap-sections {
          scroll-padding-top: 5.625rem;
        }
      }

      html.snap-sections main {
        display: flow-root;
        overflow-x: clip;
        overflow-y: visible;
      }

      html.snap-sections main > section,
      html.snap-sections .content-wrapper > footer {
        scroll-snap-align: start;
      }

      @media (prefers-reduced-motion: reduce) {
        html.snap-sections {
          scroll-snap-type: none;
        }
      }
    </style>
  </head>
  <body class:list={['page-wrapper', 'push-container', bodyClass]}>
    <Header locale={locale} path={path} paths={alternates} />
    <div class="content-wrapper push-container">
      <main>
        <slot />
      </main>
      <Footer locale={locale} path={path} paths={alternates} />
      <Modals locale={locale} />
    </div>
    <script is:inline src={withBase('/theme/js/main.min.js')}></script>
  </body>
</html>
