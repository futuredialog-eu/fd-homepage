---
import { getContent, localizePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { policyLinks } = getContent(locale);
---

<ul class="inline-list ui-navigation policy-navigation">
  {
    policyLinks.map((link) => (
      <li>
        <a href={localizePath(link.href, locale)} target={link.target}>
          {link.label}
        </a>
      </li>
    ))
  }
</ul>

<style>
  @media (width < 1024px) {
    .policy-navigation {
      flex-wrap: wrap;
    }
  }

  @media (width < 768px) {
    .policy-navigation {
      justify-content: center;
    }
  }
</style>
