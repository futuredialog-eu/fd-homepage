---
import { getContent, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className } = Astro.props;
const { counters } = getContent(locale);
---

<section class:list={['wrapper', 'counter-section', className]}>
  <div class="row counter-container">
    {
      counters.map((counter) => (
        <div class="col">
          <div class="count">{counter.count}</div>
          <div class="description">{counter.description}</div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .counter-container .count:first-letter {
    text-transform: uppercase;
  }

  .counter-container .count {
    font-size: 4rem;
    letter-spacing: -.0625rem;
    font-weight: 700;
    line-height: 1.28;
  }

  @media (width < 1440px) {
    .counter-container .count {
      font-size: 3.25rem;
      letter-spacing: -.0375rem;
    }
  }

  .counter-container {
    border-radius: .25rem;
    padding: 5rem 10%;
    position: relative;
    display: flex;
    justify-content: space-between;
    flex-grow: 1;
    margin: 0 -10%;
    background-color: var(--color-brand-90);
    text-align: center;
  }

  @media (width <= 1900px) {
    .counter-container {
      margin: 0 -5%;
    }
  }

  @media (width < 1440px) {
    .counter-container {
      margin: 0 -2%;
    }
  }

  @media (width < 768px) {
    .counter-container {
      padding: 1.875rem 10% 2.5rem;
      justify-content: center;
    }
  }

  .counter-container:before {
    top: 1.25rem;
    bottom: -.875rem;
    left: 3%;
    right: 3%;
    position: absolute;
    display: block;
    z-index: -1;
    background-color: var(--color-brand-55);
    filter: blur(10px);
    content: "";
  }

  @media (width < 768px) {
    .counter-container .col {
      width: 100%;
    }
  }

  .counter-container .count {
    color: #fff;
  }

  @media (width < 992px) {
    .counter-container .count {
      font-size: 3rem;
    }
  }

  @media (width < 768px) {
    .counter-container .count {
      margin-top: 1.25rem;
      line-height: 1;
    }
  }

  .counter-container .description {
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.9;
    color: hsla(0,0%,100%,.7);
  }

  @media (width < 992px) {
    .counter-container .description {
      font-size: 1.125rem;
    }
  }

  .customers-counter {
    transform: translateY(-160px);
  }

  @media (width < 1440px) {
    .customers-counter {
      transform: translateY(-160px);
    }
  }

  @media (width < 1024px) {
    .customers-counter {
      transform: translateY(-150px);
    }
  }

  @media (width < 992px) {
    .customers-counter {
      transform: translateY(-130px);
    }
  }

  @media (width < 768px) {
    .customers-counter {
      transform: translateY(-200px);
    }
  }
</style>
