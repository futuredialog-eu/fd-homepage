---
import { getContent, localizePath, type Locale } from '../../i18n';
import { getPosts } from '../../utils/blog';
import BlogCard from '../BlogCard.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { blogSection } = getContent(locale);
const posts = (await getPosts(locale)).slice(0, 3);
---

<section class="ui-color-section">
  <div class="wrapper latest-news-section">
    <div class="row center-xs">
      <h2 class="ui-title col-xs-12">{blogSection.title}</h2>
      <a class="ui-read-me read-me" href={localizePath(blogSection.readMoreHref, locale)}>
        {blogSection.readMore}
      </a>
    </div>
    <div class="row news-container">
      {
        posts.map((post) => (
          <BlogCard
            entry={post}
            locale={locale}
            class="col-xs-12 col-sm-6 col-lg-4"
            sizes="(width < 768px) 100vw, (width < 1024px) 50vw, 33vw"
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  .latest-news-section {
    padding-top: 8.4375rem;
    padding-bottom: 9.375rem;
  }

  @media (width < 1440px) {
    .latest-news-section {
      padding-top: 5rem;
      padding-bottom: 5rem;
    }
  }

  @media (width < 768px) {
    .latest-news-section {
      padding-top: 3.75rem;
      padding-bottom: 3.75rem;
    }
  }

  .latest-news-section .read-me {
    color: var(--color-brand);
  }

  .latest-news-section .news-container {
    margin-top: 7rem;
  }

  @media (width < 1024px) {
    .latest-news-section .news-container .ui-article:nth-child(n+3) {
      display: none;
    }
  }

  @media (width < 1440px) {
    .latest-news-section .news-container {
      margin-top: 5rem;
    }
  }

  @media (width < 768px) {
    .latest-news-section .news-container {
      margin-top: 3.125rem;
    }

    .latest-news-section .news-container .ui-article:nth-child(n+2) {
      margin-top: 2.5rem;
    }
  }
</style>
