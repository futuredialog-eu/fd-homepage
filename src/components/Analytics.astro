---
// Google Analytics 4 (gtag.js). The snippet is emitted only when
// `PUBLIC_GA_MEASUREMENT_ID` is set at build time, so local dev and any deploy
// without the variable ship no tracking and no third-party request.
const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

{
  measurementId && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${measurementId}`} />
      {/* `define:vars` keeps this inline in <head> so `gtag` and the first
          `config` call run before the deferred module bundle. */}
      <script define:vars={{ measurementId }}>
        window.dataLayer = window.dataLayer || [];
        // Kept on `window` so later inline calls (custom events) can reach it;
        // `define:vars` wraps this script in an IIFE, so a bare `function gtag`
        // would not be global.
        window.gtag =
          window.gtag ||
          function () {
            window.dataLayer.push(arguments);
          };
        gtag('js', new Date());
        gtag('config', measurementId);
      </script>
    </>
  )
}
