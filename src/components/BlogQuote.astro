---
import { contact } from '../data/site';
import { getContent, localizePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { contactSection, ui } = getContent(locale);
---

<hr class="ui-hr" />
<div class="row center-xs ui-quote-container">
  <div class="col-lg-8">
    <div class="quote">{contactSection.quote}<br /><br /></div>
    <a
      href={localizePath(contact.demoPath, locale)}
      class="ui-button ui-button-shadow nav-button fd-meet-button"
    >
      {ui.bookDemo}
    </a>
  </div>
</div>
