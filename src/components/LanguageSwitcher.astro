---
import { localeNames, locales, localizePath, withBase, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** Current path with the locale prefix stripped, e.g. `/contacts/`. */
  path?: string;
  /** Per-locale override of `path`, for pages that are not translated everywhere. */
  paths?: Record<Locale, string>;
}

const { locale, path = '/', paths } = Astro.props;
---

{
  locales.map((code) => (
    <li
      class:list={[
        'menu-item',
        'wpml-ls-item',
        `wpml-ls-item-${code}`,
        { 'wpml-ls-current-language': code === locale },
      ]}
    >
      <a href={localizePath(paths?.[code] ?? path, code)} hreflang={code}>
        <img
          class="wpml-ls-flag"
          src={withBase(`/images/flags/${code}.svg`)}
          alt={code}
          title={localeNames[code]}
        />
      </a>
    </li>
  ))
}

<style>
  :global(.block-list) > li.wpml-ls-item {
    display: inline-block;
  }

  li.wpml-ls-item > a {
    padding-right: 7px;
  }

  li.wpml-ls-item + li.wpml-ls-item > a {
    padding-left: 7px;
  }

  :global(.inline-list) > li.wpml-ls-item > a {
    padding-left: 7px;
  }

  .wpml-ls-flag {
    width: 12px;
    height: 12px;
  }

  /* The mobile menu stacks every `li` full width; keep the flags on one row. */
  @media (max-width: 1023px) {
    :global(.header .navigation) > li.wpml-ls-item {
      display: inline-block;
      width: auto;
      vertical-align: middle;
    }

    /* Line the first flag up with the 2rem indent of the menu items. */
    :global(.header .navigation) > li.wpml-ls-item > a {
      padding: 0 7px 0 2rem;
    }

    :global(.header .navigation) > li.wpml-ls-item + li.wpml-ls-item > a {
      padding-left: 7px;
    }
  }
</style>
