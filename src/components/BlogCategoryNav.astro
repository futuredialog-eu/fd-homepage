---
import type { BlogCategory } from '../data/blog';
import { getContent, localizePath, type Locale } from '../i18n';
import { categoryPath } from '../utils/blog';

interface Props {
  locale: Locale;
  categories: BlogCategory[];
  active?: BlogCategory;
}

const { locale, categories, active } = Astro.props;
const { blogPage } = getContent(locale);
---

<ul class="news-category inline-list">
  {
    categories.map((category) => (
      <li class="nav-item">
        <a
          class:list={[{ active: category === active }]}
          href={localizePath(categoryPath(category), locale)}
        >
          {blogPage.categoryLabels[category]}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .news-category {
    margin-right: -1.125rem;
  }

  @media (width < 1024px) {
    .news-category {
      margin-left: -1.125rem;
      margin-top: 1.875rem;
      margin-right: 0;
      width: 100%;
      flex-wrap: wrap;
    }
  }

  .news-category a {
    padding: .625rem 1.125rem;
    font-size: 1.0625rem;
    letter-spacing: -.00625rem;
    font-weight: 600;
    line-height: 1.7647;
    color: #000;
  }

  @media (width < 768px) {
    .news-category a {
      font-size: .9375rem;
    }
  }

  .news-category a.active,
  .news-category a:hover {
    color: var(--color-brand);
    text-decoration: none;
  }
</style>
