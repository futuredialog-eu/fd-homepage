---
import { Image } from 'astro:assets';
import SvgIcon from '../../components/SvgIcon.astro';
import Layout from '../../layouts/Layout.astro';
import { contact } from '../../data/site';
import { defaultLocale, getContent, localizePath, locales, type Locale } from '../../i18n';

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale: locale === defaultLocale ? undefined : locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };
const { featuresPage, ui } = getContent(locale);
const screenshots = import.meta.glob<{ default: ImageMetadata }>('../../assets/features/*/*.png', {
  eager: true,
});
/** The apps have no Finnish translation yet, so the Finnish page shows the English screenshots. */
const screenshotLocale: Record<Locale, Locale> = { en: 'en', de: 'de', et: 'et', sv: 'sv', fi: 'en' };
/** In the order of `featuresPage.items`; the sections alternate image side and background. */
const imageNames = ['platforms', 'data', 'posts', 'events', 'rss', 'feedback'];
const features = featuresPage.items.map((item, index) => {
  const file = `../../assets/features/${screenshotLocale[locale]}/${imageNames[index]}.png`;
  const image = screenshots[file]?.default;
  if (!image) throw new Error(`Missing features image ${file}`);
  return { ...item, image };
});
const sizes = '(width < 768px) 100vw, 60vw';
const widths = [600, 900, 1200];
---

<Layout
  locale={locale}
  path="/features/"
  title={featuresPage.meta.title}
  description={featuresPage.meta.description}
  bodyClass="features-page"
>
  <section class="features-title wrapper">
    <div class="row">
      <h1 class="col-xs-12 col-sm-10 col-md-9">{featuresPage.intro}</h1>
    </div>
  </section>
  {
    features.map((feature, index) => (
      <section class:list={{ 'ui-color-section': index % 2 === 0 }}>
        <div class="wrapper">
          <div class="row middle-xs features">
            <div
              class:list={[
                'col-xs-12 col-sm-6 col-md-offset-1 col-md-4 section-info',
                { 'first-xs last-sm': index % 2 === 1 },
              ]}
            >
              <h2 class="ui-title title">{feature.title}</h2>
              <div class="ui-description description">{feature.description}</div>
            </div>
            <div class="col-xs-12 col-sm-6 col-md-7 features-image">
              <Image src={feature.image} alt={feature.title} widths={widths} sizes={sizes} />
            </div>
          </div>
        </div>
      </section>
    ))
  }
  <section class="wrapper case-studies-section contact-section">
    <!-- <div class="row center-xs">
      <div class="col-lg-4">
        <h2 class="ui-title">{featuresPage.caseSection.title}</h2>
        <div class="ui-description">{featuresPage.caseSection.description}</div>
      </div>
    </div>
    <div class="case-container">
      {
        featuresPage.caseSection.items.map((item) => (
          <div class="case-item">
            <a href={localizePath(item.href, locale)}>
              <SvgIcon name={item.icon} sprite="svg-select-sprite" />
              <span class="title">{item.title}</span>
              <span class="ui-read-me read-me">{ui.readMore}</span>
            </a>
          </div>
        ))
      }
    </div> -->

    <div class="row center-xs ui-quote-container">
      <div class="col-lg-8">
        <div class="quote">{featuresPage.quote}<br /><br /></div>
        <a
          href={localizePath(contact.demoPath, locale)}
          data-track="book_demo"
          data-track-location="features"
          class="ui-button ui-button-shadow nav-button fd-meet-button"
        >
          {ui.bookDemo}
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  @media (width >= 1024px) {
    .features {
      height: 100vh;
      min-height: 768px;
    }
  }

  @media (768px <= width < 1024px) {
    .features .section-info {
      margin: 5rem 0;
    }
  }

  @media (width < 768px) {
    .features .section-info {
      margin: 3.75rem 0 1.25rem;
    }

    .features .features-image {
      margin-bottom: 2.5rem;
    }
  }

  @media (width < 1440px) {
    .features .title {
      font-size: 2.25rem;
    }
  }

  .features .description {
    margin-top: 2.5rem;
  }

  @media (width < 1440px) {
    .features .description {
      margin-top: 1.25rem;
      font-size: 1.125rem;
      line-height: 1.75;
    }
  }

  .features-title h1 {
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
  }

  .features-title {
    margin-top: 17.5rem;
    margin-bottom: 14rem;
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.5;
  }

  @media (width < 1440px) {
    .features-title {
      margin-top: 10rem;
      margin-bottom: 7.5rem;
      font-size: 1.75rem;
    }
  }

  @media (width < 768px) {
    .features-title {
      margin-top: 6.25rem;
      margin-bottom: 3.75rem;
      font-size: 1.375rem;
    }
  }
</style>
