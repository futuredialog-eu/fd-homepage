---
import SvgIcon from '../../components/SvgIcon.astro';
import Layout from '../../layouts/Layout.astro';
import { contact, social } from '../../data/site';
import { defaultLocale, getContent, locales, withBase, type Locale } from '../../i18n';

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale: locale === defaultLocale ? undefined : locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };
const { contactSection, contactsPage } = getContent(locale);
---

<Layout
  locale={locale}
  path="/contacts/"
  title={contactsPage.meta.title}
  description={contactsPage.meta.description}
  bodyClass="contacts"
  snapScroll
>
  <section class="ui-color-section">
    <div class="wrapper contact-form-section">
      <div class="row">
        <div class="col-xs-12 col-md-5 col-lg-offset-1 col-lg-4">
          <h1 class="ui-title">{contactsPage.title}</h1>
          <ul class="block-list contact-form-address">
            <li><a class="mail" href={`mailto:${contact.email}`}>{contact.email}</a></li>
            <li><a href={contact.phoneHref}>{contact.phone}</a></li>
            <li><a target="blank" href={contact.addressHref}>{contact.address}</a></li>
          </ul>
          <ul class="inline-list contact-form-social">
            {
              social.map((item) => (
                <li>
                  <a href={item.href}>
                    <SvgIcon name={item.icon} />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="col-xs-12 col-md-7 col-lg-6 contact-about">
          <h2 class="ui-title">{contactsPage.aboutTitle}</h2>
          <div class="ui-description description about-description">
            {contactsPage.aboutDescription}
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="wrapper contact-users-container">
    <div class="row center-sm no-wrap contact-users">
      {
        contactSection.people.map((person) => (
          <div
            itemscope
            itemtype="http://schema.org/Person"
            class="col-xs-12 col-sm-6 col-md-4 col-lg ui-contact-user"
          >
            <div class="contact-image">
              <img itemprop="image" src={withBase(person.image)} alt={person.name} />
            </div>
            <div itemprop="name" class="name">
              {person.name}
            </div>
            <div itemprop="jobTitle" class="position">
              {person.position}
            </div>
            <a itemprop="telephone" href={person.phoneHref}>
              {person.phone}
            </a>
            <a itemprop="email" href={`mailto:${person.email}`}>
              {person.email}
            </a>
          </div>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .contact-form-address a.mail {
    color: var(--color-brand);
  }

  .contact-form-section {
    padding-top: 12.5rem;
  }

  @media (width < 1440px) {
    .contact-form-section {
      padding-top: 8.125rem;
    }
  }

  @media (width < 1024px) {
    .contact-form-section {
      padding-top: 11.0625rem;
    }
  }

  @media (width < 992px) {
    .contact-form-section {
      padding-top: 9.8125rem;
    }
  }

  @media (width < 768px) {
    .contact-form-section {
      padding-top: 6.25rem;
    }
  }

  .contact-form-address {
    margin-top: 3.625rem;
  }

  @media (width < 1024px) {
    .contact-form-address {
      margin-top: 1.875rem;
    }
  }

  @media (width < 992px) {
    .contact-form-address {
      margin-top: 1.25rem;
    }
  }

  .contact-form-address a {
    font-size: 2rem;
    letter-spacing: -.0625rem;
    font-weight: 600;
    line-height: 1.625;
    color: #000;
  }

  @media (width < 768px) {
    .contact-form-address a {
      font-size: 1.5rem;
      letter-spacing: -.01875rem;
    }
  }

  .contact-users-container {
    margin-top: 8.0625rem;
    margin-bottom: 5.625rem;
  }

  @media (width < 1024px) {
    .contact-users-container {
      margin-top: 1.25rem;
      margin-bottom: 5.625rem;
    }
  }

  @media (width < 768px) {
    .contact-users-container {
      margin-top: .625rem;
      margin-bottom: 3.75rem;
    }
  }

  .contact-form-social a {
    background-color: var(--color-brand-10);
  }

  .contact-form-social a :global(svg) {
    fill: var(--color-brand);
  }

  @media (width < 992px) {
    .contact-about {
      margin-top: 3.75rem;
    }
  }

  .about-description {
    margin-top: 3rem;
    margin-bottom: 3rem;
  }
</style>
