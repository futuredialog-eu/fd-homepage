---
import BlogSection from '../../components/sections/BlogSection.astro';
import ContactSection from '../../components/sections/ContactSection.astro';
import CounterSection from '../../components/sections/CounterSection.astro';
import Hero from '../../components/sections/Hero.astro';
import HowSection from '../../components/sections/HowSection.astro';
import ReviewsSection from '../../components/sections/ReviewsSection.astro';
import Layout from '../../layouts/Layout.astro';
import { defaultLocale, locales, type Locale } from '../../i18n';

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale: locale === defaultLocale ? undefined : locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };
---

<Layout locale={locale} path="/" bodyClass="home">
  <Hero locale={locale} />
  <HowSection locale={locale} />
  <CounterSection locale={locale} />
  <ReviewsSection locale={locale} />
  <BlogSection locale={locale} />
  <ContactSection locale={locale} />
</Layout>
